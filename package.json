{
  "name": "nibraun-de",
  "version": "1.0.0",
  "description": "Personal portfolio website for Niklas Braun.",
  "main": "index.html",
  "scripts": {
    "build": "npm run build:css && npm run build:html",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "build:html": "node scripts/build-html.mjs",
    "test": "node --test scripts/*.test.mjs",
    "dev": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
    "serve": "python3 -m http.server 8000",
    "deploy": "scripts/deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nibra180/nibraun-tui.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nibra180/nibraun-tui/issues"
  },
  "homepage": "https://github.com/nibra180/nibraun-tui#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "twig": "^3.0.0"
  }
}
