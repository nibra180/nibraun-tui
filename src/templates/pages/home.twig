{% extends '../layout.twig' %}

{% block content %}
<!-- ==================== HOME ==================== -->
<main class="home-main" id="home">
  <div class="home-copy">
    <h1>{{ t('home.heading') }}</h1>
    <p class="home-teaser">{{ t('home.teaser') }}</p>
  </div>
  <div class="home-links">
    {% include '../components/home-card.twig' with {href: workPath, tone: 'blue', label: t('nav.work'), description: t('home.work'), project: homeProject, thumbnail: null, randomThumbnail: false} %}
    {% include '../components/home-card.twig' with {href: photosPath, tone: 'green', label: t('nav.photos'), description: t('home.photos'), project: null, thumbnail: homeThumbnail, randomThumbnail: true} %}
  </div>
</main>
{% endblock %}

{% block scripts %}{% include '../partials/home-script.twig' %}{% endblock %}
{% block scriptData %}<script type="application/json" id="homePhotos">{{ homePhotos|raw }}</script>{% endblock %}
