{% extends '../layout.twig' %}

{% block head %}
<script>
  // Apply the stored gallery view before first paint to avoid a layout jump.
  document.documentElement.dataset.galleryView = "grid";
  try { if (localStorage.getItem("galleryView") === "sequence") delete document.documentElement.dataset.galleryView; } catch {}
</script>
{% endblock %}

{% block content %}
<!-- ==================== PHOTOS ==================== -->
<main class="photos-main" id="photos">
  <a class="gallery-back button" href="{{ backPath }}"><span aria-hidden="true">←</span> {{ t('photos.back') }}</a>
  <h1 class="photos-title">{{ heading }}</h1>
  <div class="photos-toolbar">
  <p class="photos-description">{{ description }}</p>
  <div class="switch view-switch" role="group" aria-label="{{ t('photos.view') }}" hidden>
    <button type="button" data-gallery-view="sequence" aria-pressed="false" aria-label="{{ t('photos.view.sequence') }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="8" rx="1.5"/><rect x="3" y="13" width="18" height="8" rx="1.5"/></svg>
    </button>
    <button type="button" data-gallery-view="grid" aria-pressed="true" aria-label="{{ t('photos.view.grid') }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
    </button>
  </div>
  </div>
  <div class="photo-sequence">
    {% for image in images %}
    <figure>
      <a class="photo-open" href="{{ image.fullImageUrl }}" aria-label="{{ t('photos.lightbox.open') ~ ': ' ~ image.picture.alt }}">
        {% include '../components/picture.twig' with {picture: image.picture} %}
      </a>
      {% if image.captionKey is defined and image.captionKey %}<figcaption>{{ t(image.captionKey) }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div>
  <a class="gallery-back button" href="{{ backPath }}"><span aria-hidden="true">←</span> {{ t('photos.back') }}</a>
</main>
{% endblock %}

{% block scripts %}{% include '../partials/gallery-script.twig' %}{% endblock %}

{% block scriptData %}{% include '../partials/lightbox.twig' %}{% endblock %}
