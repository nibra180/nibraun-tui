<!doctype html>
<!-- Generated from Twig templates by scripts/build-html.mjs. Do not edit. -->
<html lang="{{ lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <meta name="author" content="Niklas Braun" />
    <meta name="robots" content="{{ indexable ? 'index, follow' : 'noindex' }}" />
    <meta name="theme-color" content="#f8efe7" />
    <meta property="og:type" content="{{ ogType|default('website') }}" />
    <meta property="og:title" content="{{ ogTitle|default(title) }}" />
    <meta property="og:description" content="{{ ogDescription|default(description) }}" />
    <meta property="og:url" content="{{ url }}" />
    {% if ogLocale %}
    <meta property="og:locale" content="{{ ogLocale }}" />
    <meta property="og:locale:alternate" content="{{ ogLocaleAlternate }}" />
    {% endif %}
    {% if ogImage|default(false) %}
    <meta property="og:image" content="https://nibraun.de/img/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ t('meta.ogImageAlt') }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ ogTitle|default(title) }}" />
    <meta name="twitter:description" content="{{ ogDescription|default(description) }}" />
    <meta name="twitter:image" content="https://nibraun.de/img/og-image.png" />
    {% endif %}
    {% if indexable %}
    <link rel="canonical" href="{{ url }}" />
    <link rel="alternate" hreflang="en" href="{{ enUrl }}" />
    <link rel="alternate" hreflang="de" href="{{ deUrl }}" />
    <link rel="alternate" hreflang="x-default" href="{{ enUrl }}" />
    {% endif %}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%23171717'/%3E%3Ctext x='50' y='72' font-family='Arial' font-size='64' fill='%23f7f7f4' text-anchor='middle'%3EN%3C/text%3E%3C/svg%3E" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/dist/tailwind.css" />
    {% include 'partials/theme-init.twig' %}
    {% if legacyPath|default(false) %}
    <script>if (new URLSearchParams(location.search).get("lang") === "de") location.replace({{ legacyPath|raw }});</script>
    {% endif %}
    {% if jsonLd|default(false) %}<script type="application/ld+json">{{ jsonLd|raw }}</script>{% endif %}
    {% block head %}{% endblock %}
  </head>
  <body>
    <a class="skip-link" href="#{{ mainId }}">{{ skipLabel }}</a>
    <div class="top-bar" aria-hidden="true"></div>
    <div class="page {{ pageClass|default('') }}">
      <!-- ==================== HEADER ==================== -->
      {% include 'partials/header.twig' %}
      {% block content %}{% endblock %}
      <!-- ==================== FOOTER ==================== -->
      {% include 'partials/footer.twig' %}
    </div>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        {% include 'partials/theme-script.twig' %}
        {% block scripts %}{% endblock %}
      });
    </script>
    {% block scriptData %}{% endblock %}
  </body>
</html>
