<header class="site-header">
  <nav class="site-nav" aria-label="{{ t('nav.menu') }}">
    <a class="tone-purple" href="{{ homePath }}"{% if activePage == 'home' %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.7 2.7a2 2 0 0 1 2.6 0l8 6.8a1.2 1.2 0 0 1-.8 2.1H20V19a2 2 0 0 1-2 2h-4v-6a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v6H6a2 2 0 0 1-2-2v-7.4h-.5a1.2 1.2 0 0 1-.8-2.1Z"/></svg>
      <span>{{ t('nav.homeLabel') }}</span>
    </a>
    <a class="tone-blue" href="{{ devPath }}"{% if activePage == 'dev' %} aria-current="page"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M6 3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm3 4.7L5.4 11.3a1 1 0 0 0 0 1.4L9 16.3l1.4-1.4L7.5 12l2.9-2.9Zm6 0-1.4 1.4 2.9 2.9-2.9 2.9 1.4 1.4 3.6-3.6a1 1 0 0 0 0-1.4Z"/></svg>
      <span>{{ t('nav.dev') }}</span>
    </a>
    <a class="tone-green" href="{{ photosPath }}"{% if activePage == 'photos' %} aria-current="page"{% elseif activePage == 'gallery' %} aria-current="location"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M6 3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3Zm2 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-2 12h12l-3.7-5.5a1 1 0 0 0-1.6 0L10 16l-1.3-1.3a1 1 0 0 0-1.4 0Z"/></svg>
      <span>{{ t('nav.photos') }}</span>
    </a>
  </nav>
  <div class="header-controls">
    <nav class="switch language-switch" aria-label="{{ t('nav.language') }}">
      <a href="{{ enPath }}" hreflang="en" lang="en"{% if lang == 'en' %} aria-current="page"{% endif %}>EN</a>
      <a href="{{ dePath }}" hreflang="de" lang="de"{% if lang == 'de' %} aria-current="page"{% endif %}>DE</a>
    </nav>
    {% include 'theme-controls.twig' %}
  </div>
</header>
