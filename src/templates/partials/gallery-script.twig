const viewSwitch = document.querySelector(".view-switch");
document.querySelectorAll(".photo-sequence figure").forEach((figure) => {
  const image = figure.querySelector("img");
  figure.style.setProperty("--ratio", image.getAttribute("width") / image.getAttribute("height"));
});
function applyGalleryView(view, store = false) {
  if (view === "grid") document.documentElement.dataset.galleryView = "grid";
  else delete document.documentElement.dataset.galleryView;
  viewSwitch.querySelectorAll("[data-gallery-view]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.galleryView === view)));
  if (store) try { localStorage.setItem("galleryView", view); } catch {}
}
viewSwitch.querySelectorAll("[data-gallery-view]").forEach((button) => button.addEventListener("click", () => applyGalleryView(document.documentElement.dataset.galleryView === "grid" ? "sequence" : "grid", true)));
applyGalleryView(document.documentElement.dataset.galleryView === "grid" ? "grid" : "sequence");
viewSwitch.hidden = false;

const lightbox = document.querySelector(".lightbox");
if (lightbox && typeof lightbox.showModal === "function") {
  const links = [...document.querySelectorAll(".photo-open")];
  const stage = lightbox.querySelector(".lightbox-stage");
  const closeButton = lightbox.querySelector(".lightbox-close");
  const previousButton = lightbox.querySelector(".lightbox-previous");
  const nextButton = lightbox.querySelector(".lightbox-next");
  const counter = lightbox.querySelector(".lightbox-counter");
  const caption = lightbox.querySelector(".lightbox-caption");
  const error = lightbox.querySelector(".lightbox-error");
  const announcement = lightbox.querySelector(".lightbox-announcement");
  let currentIndex = 0;
  let opener = null;
  let currentPicture = null;
  let blankPointerDown = false;

  function positionLabel() {
    return lightbox.dataset.positionLabel.replace("{current}", currentIndex + 1).replace("{total}", links.length);
  }

  function updateLightboxSizes() {
    if (!lightbox.open || !currentPicture) return;
    const image = currentPicture.querySelector("img");
    const width = Number(image.getAttribute("width"));
    const height = Number(image.getAttribute("height"));
    const size = Math.max(1, Math.ceil(Math.min(width, stage.clientWidth, stage.clientHeight * width / height)));
    currentPicture.querySelectorAll("source, img").forEach((element) => element.setAttribute("sizes", `${size}px`));
  }

  function showLightboxImage(index) {
    if (index < 0 || index >= links.length) return;
    currentIndex = index;
    currentPicture?.remove();
    currentPicture = null;
    error.hidden = true;
    counter.textContent = `${index + 1} / ${links.length}`;
    previousButton.disabled = index === 0;
    nextButton.disabled = index === links.length - 1;
    caption.textContent = links[index].closest("figure").querySelector("figcaption")?.textContent ?? "";
    caption.hidden = !caption.textContent;

    const picture = links[index].querySelector("picture").cloneNode(true);
    const image = picture.querySelector("img");
    image.setAttribute("loading", "eager");
    image.removeAttribute("fetchpriority");
    currentPicture = picture;
    updateLightboxSizes();
    stage.setAttribute("aria-busy", "true");
    announcement.textContent = `${positionLabel()}: ${image.alt}`;

    function finishLoading(failed) {
      // A response from an earlier photo must not change the current photo's state.
      if (!lightbox.open || currentPicture !== picture) return;
      stage.setAttribute("aria-busy", "false");
      error.hidden = !failed;
      picture.hidden = failed;
      if (failed) announcement.textContent = `${positionLabel()}: ${error.textContent}`;
    }
    image.addEventListener("load", () => finishLoading(false), { once: true });
    image.addEventListener("error", () => finishLoading(true), { once: true });
    stage.append(picture);
    if (image.complete) finishLoading(image.naturalWidth === 0);
  }

  links.forEach((link, index) => {
    link.setAttribute("aria-haspopup", "dialog");
    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      document.documentElement.classList.add("lightbox-open");
      lightbox.showModal();
      showLightboxImage(index);
      closeButton.focus({ preventScroll: true });
    });
  });
  closeButton.addEventListener("click", () => lightbox.close());
  previousButton.addEventListener("click", () => showLightboxImage(currentIndex - 1));
  nextButton.addEventListener("click", () => showLightboxImage(currentIndex + 1));
  lightbox.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
      event.preventDefault();
      showLightboxImage(currentIndex + (event.key === "ArrowRight" ? 1 : -1));
    }
  });
  const isBlank = (target) => target === lightbox || target === stage;
  lightbox.addEventListener("pointerdown", (event) => { blankPointerDown = isBlank(event.target); });
  lightbox.addEventListener("click", (event) => {
    const image = currentPicture?.querySelector("img");
    if (event.button === 0 && image && event.target === image) {
      const bounds = image.getBoundingClientRect();
      showLightboxImage(currentIndex + (event.clientX < bounds.left + bounds.width / 2 ? -1 : 1));
    } else if (blankPointerDown && isBlank(event.target)) lightbox.close();
    blankPointerDown = false;
  });
  lightbox.addEventListener("close", () => {
    document.documentElement.classList.remove("lightbox-open");
    currentPicture?.remove();
    currentPicture = null;
    announcement.textContent = "";
    stage.setAttribute("aria-busy", "false");
    opener?.focus({ preventScroll: true });
    opener = null;
  });
  if (typeof ResizeObserver === "function") new ResizeObserver(updateLightboxSizes).observe(stage);
  else window.addEventListener("resize", updateLightboxSizes);
}
