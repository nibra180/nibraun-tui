<footer class="site-footer">
  <span>© {{ year }} Niklas Braun</span>
  <nav class="footer-legal" aria-label="{{ t('legal.footer') }}">
    <a href="{{ imprintPath }}"{% if activePage == 'imprint' %} aria-current="page"{% endif %}>{{ t('imprint.title') }}</a>
    <a href="{{ privacyPath }}"{% if activePage == 'privacy' %} aria-current="page"{% endif %}>{{ t('privacy.link') }}</a>
  </nav>
  {% if footerWarikoda|default(false) %}<span>{{ t('footer.warikoda')|raw }}</span>{% endif %}
</footer>
<div class="footer-controls">
  {% include 'language-theme-controls.twig' %}
</div>
