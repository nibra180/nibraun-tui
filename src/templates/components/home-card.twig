<a class="home-card tone-{{ tone }}" href="{{ href }}">
  <span class="home-card-image" aria-hidden="true">
    {% if project %}{% include 'cover.twig' %}
    {% elseif thumbnail %}{% include 'picture.twig' with {picture: thumbnail} %}
    {% else %}<span class="home-card-placeholder"></span>{% endif %}
  </span>
  <span class="home-card-heading"><span>{{ label }}</span><span class="home-card-arrow" aria-hidden="true">→</span></span>
  <span class="home-card-description">{{ description }}</span>
</a>
