<div class="preview-panel {{ project.tone }}{% if not first %} is-inactive{% endif %}">
  {% include 'cover.twig' %}
  <h3 class="preview-title"><span>{{ project.name }}</span><span class="mono">{% if project.year is defined %}{{ project.year }}{% endif %}</span></h3>
  <p class="preview-desc">{{ t(project.descriptionKey) }}</p>
  <span class="mono">{{ project.stack }}</span>
  <a class="preview-link" href="{{ project.href }}" target="_blank" rel="noopener noreferrer">{% if project.repo is defined and project.repo %}{{ t('work.openOn') }}{% else %}{{ t('work.openWebsite') }}{% endif %} <span aria-hidden="true">↗</span></a>
</div>
